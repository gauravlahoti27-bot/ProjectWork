# Copy to .env and fill in. NEVER commit .env.
PORTAL_REVIEWER_PUBLIC_KEY=   # contents of keys/reviewer.pub from KeyGenTool
PORTAL_REVIEWER_USERNAME=reviewer
PORTAL_REVIEWER_PASSWORD=     # long random passphrase
PORTAL_ORG=OnionLeaks
PORTAL_ONION_ADDRESS=         # fill after: docker compose exec tor cat /var/lib/tor/onionleaks/hostname
PORTAL_MAX_FILE_MB=25
